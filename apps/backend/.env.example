NODE_ENV=development
APP_NAME=qwen-autopilot-api
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=4001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
JWT_ACCESS_TOKEN_SECRET=replace-with-secret-manager-value
JWT_ACCESS_TOKEN_TTL=15m
DATABASE_URL=postgresql://autopilot:change-me-local-only@localhost:5432/autopilot
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ── AI Providers ─────────────────────────────────────────────────
# The platform supports multiple AI providers. Configure one or more.

# ── Qwen / DashScope (Default) ──
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── OpenAI ──
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=your-org-id

# ── Anthropic ──
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ── LiteLLM ──
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=your-litellm-master-key
# LITELLM_VIRTUAL_KEY=team-or-user-virtual-key
# LITELLM_TEAM_ID=your-team-id
# LITELLM_FALLBACK_MODELS=gpt-4o,claude-3-5-sonnet,qwen-plus

# ── NVIDIA NIM ──
# NIM_BASE_URL=http://localhost:8000/v1
# NIM_API_KEY=your-nim-api-key
# NGC_API_KEY=your-ngc-api-key
# NIM_MODEL_REPOSITORY=nemotron-3-ultra
# NIM_ENABLE_PROFILING=false

# ── Custom Providers ──
# CUSTOM_PROVIDER_MYMODEL_URL=http://localhost:8000/v1
# CUSTOM_PROVIDER_MYMODEL_KEY=local-key
# CUSTOM_PROVIDER_MYMODEL_DEFAULT_MODEL=llama-3-70b
# CUSTOM_PROVIDER_MYMODEL_PRIORITY=50