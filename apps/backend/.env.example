NODE_ENV=development
APP_NAME=qwen-autopilot-api
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
JWT_ACCESS_TOKEN_SECRET=replace-with-secret-manager-value
JWT_ACCESS_TOKEN_TTL=15m
DATABASE_URL=postgresql://autopilot:change-me-local-only@localhost:5432/autopilot
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
