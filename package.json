{
  "name": "qwen-autopilot-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade foundation for an enterprise AI Autopilot Agent platform.",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "dev:apps": "pnpm -r --parallel --filter './apps/*' dev",
    "dev:infra": "podman compose -f podman-compose.yml up -d",
    "build": "bash scripts/build.sh",
    "test": "bash scripts/test.sh",
    "test:e2e": "pnpm --filter @qwen-autopilot/frontend test:e2e",
    "lint": "bash scripts/lint.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "bash scripts/clean.sh",
    "seed": "bash scripts/seed.sh",
    "reset-db": "bash scripts/reset-db.sh",
    "health-check": "bash scripts/health-check.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0"
  }
}
