# ─── Qwen Autopilot Development Environment ───

# ── General ──
NODE_ENV=development
APP_NAME=qwen-autopilot-dev

# ── Ports ──
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=15432
REDIS_PORT=16379

# ── Database (Container Internal & External) ──
# DB_HOST should be set to "database" when running inside containers
DB_HOST=database
DB_PORT=5432
DB_NAME=autopilot
DB_USER=autopilot
DB_PASSWORD=change-me-local-only

# Connection string for NestJS backend inside the container:
DATABASE_URL=postgresql://autopilot:change-me-local-only@database:5432/autopilot?schema=public

# Connection string for running migrations / seeds from host machine:
# DATABASE_URL=postgresql://autopilot:change-me-local-only@localhost:5432/autopilot?schema=public

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ── Authentication ──
JWT_ACCESS_TOKEN_SECRET=replace-with-a-secure-development-secret-for-jwt-signing
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ── Credential Encryption ──
CREDENTIAL_ENCRYPTION_KEY=12345678901234567890123456789012

# ── Qwen AI (Alibaba Cloud DashScope) ──
# Get your API key from the Alibaba Cloud Model Studio console
QWEN_API_KEY=your-qwen-api-key-here
# Use dashscope-intl for International Model Studio keys; dashscope.aliyuncs.com for Mainland China keys.
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Seeding Configuration ──
SEED_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME="System Administrator"

# ── Frontend Public / Server Config ──
# Browser-accessible URL for the Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Qwen Autopilot"

# ── Observability ──
# Prometheus metrics endpoint (GET /metrics on the backend)
METRICS_ENABLED=true
# OpenTelemetry distributed tracing (OTLP/HTTP exporter)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=qwen-autopilot-api
