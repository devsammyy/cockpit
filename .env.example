# ─── Qwen Autopilot Development Environment ───

# ── General ──
NODE_ENV=development
APP_NAME=qwen-autopilot-dev

# ── Ports ──
FRONTEND_PORT=3000
BACKEND_PORT=4001
POSTGRES_PORT=15432
REDIS_PORT=16379

# ── Database (Container Internal & External) ──
# DB_HOST should be set to "database" when running inside containers
DB_HOST=database
DB_PORT=5432
DB_NAME=autopilot
DB_USER=autopilot
DB_PASSWORD=change-me-local-only

# Connection string for NestJS backend inside the container:
DATABASE_URL=postgresql://autopilot:change-me-local-only@database:5432/autopilot?schema=public

# Connection string for running migrations / seeds from host machine:
# DATABASE_URL=postgresql://autopilot:change-me-local-only@localhost:5432/autopilot?schema=public

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ── Authentication ──
JWT_ACCESS_TOKEN_SECRET=replace-with-a-secure-development-secret-for-jwt-signing
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ── Credential Encryption ──
CREDENTIAL_ENCRYPTION_KEY=12345678901234567890123456789012

# ── AI Providers ─────────────────────────────────────────────────
# The platform supports multiple AI providers simultaneously.
# Configure one or more providers; the system will use the highest priority
# enabled provider as primary, with automatic fallback on failures.

# ── Qwen / DashScope (Default) ──
# Get your API key from the Alibaba Cloud Model Studio console
QWEN_API_KEY=your-qwen-api-key-here
# Use dashscope-intl for International Model Studio keys; dashscope.aliyuncs.com for Mainland China keys.
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── OpenAI ──
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=your-org-id

# ── Anthropic (via LiteLLM or OpenAI-compatible proxy) ──
# ANTHROPIC_API_KEY=your-anthropic-key-here

# ── LiteLLM (Unified Gateway for 100+ models) ──
# LiteLLM acts as a proxy/router supporting OpenAI, Anthropic, Cohere, Azure, Vertex, etc.
# LITELLM_BASE_URL=http://localhost:4000  # or your LiteLLM proxy URL
# LITELLM_API_KEY=your-litellm-master-key
# LITELLM_VIRTUAL_KEY=team-or-user-virtual-key
# LITELLM_TEAM_ID=your-team-id
# LITELLM_FALLBACK_MODELS=gpt-4o,claude-3-5-sonnet,qwen-plus  # Comma-separated fallbacks

# ── NVIDIA NIM (Optimized Inference Microservices) ──
# NIM_BASE_URL=http://localhost:8000/v1  # Your NIM endpoint
# NIM_API_KEY=your-nim-api-key
# NGC_API_KEY=your-ngc-api-key
# NIM_MODEL_REPOSITORY=nemotron-3-ultra
# NIM_ENABLE_PROFILING=false

# ── Custom OpenAI-Compatible Providers ──
# Add any number of custom providers using the pattern:
# CUSTOM_PROVIDER_<NAME>_URL=<base-url>
# CUSTOM_PROVIDER_<NAME>_KEY=<api-key>
# CUSTOM_PROVIDER_<NAME>_DEFAULT_MODEL=<model-id>
# CUSTOM_PROVIDER_<NAME>_TOOL_MODEL=<model-id-for-tools>
# CUSTOM_PROVIDER_<NAME>_PRIORITY=<number>  # Higher = tried first
# CUSTOM_PROVIDER_<NAME>_ENABLED=true
# CUSTOM_PROVIDER_<NAME>_HEADERS='{"Custom-Header": "value"}'
#
# Example:
# CUSTOM_PROVIDER_MYMODEL_URL=http://localhost:8000/v1
# CUSTOM_PROVIDER_MYMODEL_KEY=local-key
# CUSTOM_PROVIDER_MYMODEL_DEFAULT_MODEL=llama-3-70b
# CUSTOM_PROVIDER_MYMODEL_PRIORITY=50

# ── Seeding Configuration ──
SEED_ADMIN=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_DISPLAY_NAME="System Administrator"

# ── Frontend Public / Server Config ──
# Browser-accessible URL for the Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_APP_NAME="Qwen Autopilot"

# ── Observability ──
# Prometheus metrics endpoint (GET /metrics on the backend)
METRICS_ENABLED=true
# OpenTelemetry distributed tracing (OTLP/HTTP exporter)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=qwen-autopilot-api